# Copy to .env before running docker compose.
# Secret used to sign dashboard session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Public base URL of the ingest service, as reachable by YOUR apps' Sentry SDKs.
# Used only to render DSNs in the dashboard.
INGEST_PUBLIC_URL=http://localhost:3001

# Set to 1 if the dashboard is served over HTTPS (marks the session cookie Secure).
#COOKIE_SECURE=1

# Host ports (change if 3000/3001 are taken; keep INGEST_PUBLIC_URL in sync).
#WEB_PORT=3000
#INGEST_PORT=3001

# How long raw events are kept (issue counts are permanent). Changing this
# updates the TTL index on the next ingest restart.
#EVENT_RETENTION_DAYS=30
